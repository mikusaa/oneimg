services:
  oneimg:
    build: .
    container_name: oneimg
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./data:/app/data
      - ./uploads:/app/uploads
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-1000}
      TZ: Asia/Shanghai
      APP_URL: ${APP_URL:-http://localhost:8080}
      PASSKEY_RP_ID: ${PASSKEY_RP_ID:-}
      PASSKEY_ORIGINS: ${PASSKEY_ORIGINS:-}
      PASSKEY_RP_NAME: ${PASSKEY_RP_NAME:-OneImg}
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

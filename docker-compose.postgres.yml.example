# OneImg + 内置 PostgreSQL。用法见 docs/deployment.md#postgresql-compose
# 复制为 docker-compose.yml，并在同目录的 .env 中设置 POSTGRES_PASSWORD。
services:
  oneimg:
    image: ghcr.io/mikusaa/oneimg:v4.5.1
    # 从当前检出的源码构建时，注释上一行并启用下一行
    # build: .
    container_name: oneimg
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "8080:8080"
    networks: [web, database]
    volumes:
      - ./data:/app/data
      - ./uploads:/app/uploads
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-1000}
      TZ: ${TZ:-Asia/Shanghai}
      APP_URL: ${APP_URL:-http://localhost:8080}
      DB_TYPE: postgres
      # 数据库只在内部网络可达，因此显式关闭 TLS；跨主机连接须改用 verify-full。
      # 密码直接拼入 URL，应只含字母和数字，例如 openssl rand -hex 32 的输出。
      DATABASE_URL: postgresql://oneimg:${POSTGRES_PASSWORD:?在 .env 中设置 POSTGRES_PASSWORD}@postgres:5432/oneimg?sslmode=disable
      STATE_DIR: /app/data
      PASSKEY_RP_ID: ${PASSKEY_RP_ID:-}
      PASSKEY_ORIGINS: ${PASSKEY_ORIGINS:-}
      PASSKEY_RP_NAME: ${PASSKEY_RP_NAME:-OneImg}
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"

  postgres:
    image: postgres:17.11
    restart: unless-stopped
    networks: [database]
    environment:
      POSTGRES_USER: oneimg
      POSTGRES_DB: oneimg
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?在 .env 中设置 POSTGRES_PASSWORD}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U oneimg -d oneimg"]
      interval: 5s
      timeout: 5s
      retries: 20

networks:
  # 应用经此网络对外提供服务并访问远端存储
  web: {}
  # 数据库不映射宿主机端口，也不能访问外网
  database:
    internal: true

volumes:
  postgres-data: {}
